from utils.Code.helperfunctions import read_config

class KinectCamera:
    def __init__(self, device_id):
        self.config = read_config(r"W:\CameraCalibration\CONFIGS\Kinect.yaml")
        self.device_id = device_id
        self.azure_config = Config(
            color_resolution=ColorResolution(self.config['ColorResolution']),
            color_format=ImageFormat(self.config['ImageFormat']),
            depth_mode=DepthMode(self.config['DepthMode']),
            camera_fps=FPS(self.config['FPS']),
            synchronized_images_only=self.config.get('SynchronizedImagesOnly', False)
        )
        self.k4a = PyK4A(config=self.azure_config, device_id=self.device_id)
        self.k4a.open()
        self.serial = self.k4a.serial
        print(f"Kamera geöffnet – Seriennummer: {self.serial}")

    def get_capture(self):
        self.k4a.start()
        cap = self.k4a.get_capture()
        self.k4a.stop()
        return cap

    def close(self):
        self.k4a.close()


