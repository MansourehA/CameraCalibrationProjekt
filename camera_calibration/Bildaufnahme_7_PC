def load_calib_npys(folder, prefix_hint=""):
    #  suchen nach *camera_matrix.npy و *distortion_coeffs.npy
    def pick(pattern_fallback):
        cands = glob.glob(os.path.join(folder, f"{prefix_hint}*{pattern_fallback}"))
        if not cands:
            cands = glob.glob(os.path.join(folder, f"*{pattern_fallback}"))
        if not cands:
            raise FileNotFoundError(f"File not found: {pattern_fallback} در {folder}")
        return cands[0]

    k_path = pick("camera_matrix.npy")
    d_path = pick("distortion_coeffs.npy")

    K = np.load(k_path)
    dist = np.load(d_path)
    return K, dist


def build_undistort_maps(K, dist, img_size):
    h, w = img_size
    newK, _ = cv2.getOptimalNewCameraMatrix(K, dist, (w, h), alpha=0.0, newImgSize=(w, h))
    map1, map2 = cv2.initUndistortRectifyMap(K, dist, None, newK, (w, h), cv2.CV_16SC2)
    return map1, map2, newK

def show_scaled(win, img, scale=0.3):
    if not SHOW_PREVIEW:
        return
    h, w = img.shape[:2]
    small = cv2.resize(img, (int(w*scale), int(h*scale)), interpolation=cv2.INTER_AREA)
    cv2.imshow(win, small)
    cv2.waitKey(1)



